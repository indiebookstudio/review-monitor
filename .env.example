# =====================================================================
# KDP PERFORMANCE DASHBOARD - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill with your secrets. Never commit .env!
# =====================================================================

# Security
APP_SECRET_KEY=change-this-to-a-very-long-and-random-secret-key-for-sessions
# Initial admin password (plain text on first run to seed hash) OR pre-hashed password
ADMIN_PASSWORD=admin_secret_password_change_me
# Optional: ADMIN_PASSWORD_HASH=$2b$12$...

# Persistent Database URL
# Local development default: sqlite:///./data/kdp_monitor.db
# Cloud PostgreSQL (Supabase / Neon / Render / Railway):
# postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/kdp_monitor.db

# Email Notification Settings (Gmail SMTP or any standard SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_16_char_app_password
ALERT_EMAIL=recipient_email@example.com
NOTIFICATIONS_ENABLED=true

# Public URL of the deployed dashboard (used for the "APRI DASHBOARD" button in email alerts)
DASHBOARD_URL=http://localhost:8000

# Monitoring Defaults
CHECK_FREQUENCY_HOURS=24
USE_PLAYWRIGHT_FALLBACK=false
